# Local Docker Compose settings. Copy to .env only when overriding defaults.
POSTGRES_DB=resolveai
POSTGRES_USER=resolveai
POSTGRES_PASSWORD=replace_for_shared_environments
RESOLVEAI_ENVIRONMENT=development
RESOLVEAI_LOG_LEVEL=INFO
RESOLVEAI_SESSION_COOKIE_SECURE=false
RESOLVEAI_AI_MODE=local_demo
RESOLVEAI_AI_TIMEOUT_SECONDS=20
RESOLVEAI_AI_CONFIDENCE_THRESHOLD=0.70
RESOLVEAI_KNOWLEDGE_DATA_DIR=/data/knowledge

# Optional hosted structured-output provider. Local demo mode requires no key.
RESOLVEAI_LLM_BASE_URL=https://api.openai.com/v1
# RESOLVEAI_LLM_MODEL=
# RESOLVEAI_LLM_API_KEY=
BACKEND_PORT=8000
FRONTEND_PORT=3000

# Optional hosted AI integrations are introduced in Phase 3. No key is
# required for Phase 1 or for the future deterministic local demo mode.
# RESOLVEAI_LLM_API_KEY=
